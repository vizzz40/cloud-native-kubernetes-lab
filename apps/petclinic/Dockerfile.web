# syntax=docker/dockerfile:1

# Build context: a pinned Angular checkout with our nginx.conf at its root.
# Use Node 24 for builds and a compatible unprivileged Nginx runtime image.
# Supply reviewed image digests through these required build arguments.
ARG BUILD_IMAGE
ARG RUNTIME_IMAGE

# Compile separately; Node is not needed to serve the finished files.
FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY . .

# Replace the browser's localhost API address with a relative URL.
# Stop if upstream configuration changes; preserve its license comments.
RUN node -e "\
const fs = require('fs'); \
const p = 'src/environments/environment.prod.ts'; \
const s = fs.readFileSync(p, 'utf8'); \
const old = 'http://localhost:9966/petclinic/api/'; \
if (!s.includes(old)) throw new Error('Unexpected API configuration'); \
fs.writeFileSync(p, s.replace(old, '/petclinic/api/'));"

# Install from the lockfile; build only if installation succeeds.
RUN npm ci \
    && npm run build -- --configuration production

# Stop on errors (-e) or unset variables (-u).
# Require one generated site root; reject missing or ambiguous output.
# Copy its contents, including hidden files, into a stable folder.
RUN set -eu; \
    index_files="$(find dist -type f -name index.html)"; \
    test -n "$index_files"; \
    test "$(printf '%s\n' "$index_files" | wc -l)" -eq 1; \
    mkdir /site; \
    cp -R "$(dirname "$index_files")"/. /site/

# Start fresh with unprivileged Nginx instead of the Node environment.
FROM ${RUNTIME_IMAGE}

# Configure proxying and copy the compiled frontend into the web root.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /site/ /usr/share/nginx/html/

# Metadata only; nginx.conf actually sets the listening port.
EXPOSE 8080

# Keep the runtime image's non-root user and Nginx startup command.
