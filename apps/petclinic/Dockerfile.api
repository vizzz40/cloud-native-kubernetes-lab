# syntax=docker/dockerfile:1

# Build context: a pinned spring-petclinic-rest checkout, not the lab root.
# Required inputs: a JDK 21 build image and a Java 21 runtime image.
# Pass reviewed digests with --build-arg; ARG values alone do not pin images.
ARG BUILD_IMAGE
ARG RUNTIME_IMAGE

# Compile and test in a separate stage called "build".
FROM ${BUILD_IMAGE} AS build

# Run the following commands inside /src.
WORKDIR /src
# Copy the upstream source, including the Maven wrapper and license files.
COPY . .

# Allow the project's Maven wrapper script to execute.
# Each && runs the next command only if the previous command succeeds.
RUN chmod +x mvnw \
    # Use the project's Maven version; the wrapper downloads it if needed.
    # -B avoids interactive prompts; Maven still uses the command line and logs.
    # -D sets a project property; it does not install or select the actual JDK.
    # clean removes old output; verify runs the configured lifecycle checks.
    && ./mvnw -B -Djava.version=21 clean verify \
    # Create a folder to hold the JAR that the runtime stage will copy.
    && mkdir /out \
    # Search directly inside target for the built application JAR.
    # * matches varying filename text; exclude source and documentation JARs.
    && find target -maxdepth 1 -type f \
         -name 'spring-petclinic-rest-*.jar' \
         ! -name '*sources*' \
         ! -name '*javadoc*' \
         # Require one match, then copy it to the stable name app.jar.
         # {} supplies filenames; + groups them; sh fills the shell's $0 slot.
         -exec sh -c 'test "$#" -eq 1 && cp "$1" /out/app.jar' sh {} + \
    # Check that the copied file exists and is not empty; not a unit test.
    && test -s /out/app.jar

# Start fresh without carrying over the build tools or source.
FROM ${RUNTIME_IMAGE}

# Use /app as the application's working directory.
WORKDIR /app
# Copy only the built JAR from the earlier stage.
COPY --from=build /out/app.jar /app/app.jar

# Run as numeric user ID 10001 and group ID 10001, not root (ID 0).
# This selects IDs; it does not create a named user or change file ownership.
USER 10001:10001

# Document the port; this does not publish it or start a listener.
EXPOSE 9966

# Start Java directly when the container starts, using the application JAR.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
